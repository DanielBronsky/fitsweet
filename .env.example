# Скопируйте в .env и заполните.
# Секрет для подписи сессий админки: openssl rand -hex 32
PAYLOAD_SECRET=
# База SQLite (файл). На VPS — абсолютный путь вне папки релиза, например file:/var/lib/fitsweet/fitsweet.db
DATABASE_URL=file:./data/fitsweet.db
# Папка с загруженными картинками и нарезкой, например /var/lib/fitsweet/media
MEDIA_DIR=./media
# Адрес сайта для canonical, hreflang, sitemap и OG
NEXT_PUBLIC_SITE_URL=https://fitsweet.md
# Индексация поисковиками. false — только для тестового сервера (закрывает сайт от Google)
SITE_INDEXING=true
# Telegram-бот заказов: токен от @BotFather и логин бота без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Подтверждение входа в админку через Telegram: off — выключить (аварийно, если бот недоступен)
ADMIN_2FA=
# Cookie входа только по HTTPS. На сервере true, локально по http — пусто
ADMIN_COOKIE_SECURE=
# Отдельный бот для админов: подтверждение входа, тревоги сервера, утренняя сводка. Пусто — всё через бот заказов
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_USERNAME=
# --- Сервер (docker-compose) ---
SITE_URL=https://fitsweet.md
SITE_DOMAIN=fitsweet.md
ADMIN_DOMAIN=admin.fitsweet.md
ADMIN_URL=https://admin.fitsweet.md
ACME_EMAIL=
DATA_DIR=/srv/fitsweet/data
# Сторож: внешняя проверка https://healthchecks.io (пусто — выключено), сводка (off — выключить), часы бэкапа и сводки
HEALTHCHECKS_URL=
MORNING_REPORT=
BACKUP_HOUR=3
REPORT_HOUR=9
