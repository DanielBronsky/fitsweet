{
	email {$ACME_EMAIL}
	{$CADDY_GLOBAL}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
	encode zstd gzip
}

{$SITE_DOMAIN} {
	import security
	@private {
		path /admin* /api/*
		not path /api/order
	}
	respond @private 404
	reverse_proxy app:3000
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$ADMIN_DOMAIN} {
	import security
	@root path /
	redir @root /admin 302
	@health path /api/health*
	respond @health 404
	reverse_proxy app:3000
}
